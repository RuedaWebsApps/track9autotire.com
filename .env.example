# ==============================================================================
# Track 9 Auto & Tire — Decoupled Zero-CPU Contact Form Configuration
# ==============================================================================
# Original WordPress admin / recipient email: confg.ruedalarola@gmail.com
# Configure ONE provider below in Vercel Environment Variables (never commit .env).

# Provider mode: "web3forms" (default) or "webhook" (e.g., n8n / Make / Zapier)
VITE_CONTACT_PROVIDER=web3forms

# Option A: Web3Forms (https://web3forms.com — route submissions to confg.ruedalarola@gmail.com)
VITE_WEB3FORMS_ACCESS_KEY=

# Option B: Custom HTTPS Webhook (if using VITE_CONTACT_PROVIDER=webhook)
# Note: Remember to allow the webhook origin in vercel.json Content-Security-Policy connect-src.
VITE_CONTACT_WEBHOOK_URL=
